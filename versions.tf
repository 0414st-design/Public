# ==============================================================================
# versions: プロバイダーとTerraformのバージョン制約を定義する。
# バージョンを固定することで、予期しないアップグレードによる破壊的変更を防ぐ。
# ==============================================================================

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.30.0"
    }
  }
}